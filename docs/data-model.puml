@startuml data-model
hide empty members
hide circle
skinparam shadowing false
skinparam roundCorner 10
skinparam classAttributeIconSize 0
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam nodesep 70
skinparam ranksep 60
skinparam ArrowColor #6b7280
skinparam ArrowThickness 1.2
skinparam ArrowFontColor #2b2f36
skinparam ClassBorderColor #9ca3af
skinparam ClassBorderThickness 1.2
skinparam ClassBackgroundColor #ffffff
skinparam ClassHeaderBackgroundColor #eceff3
skinparam ClassFontStyle bold
skinparam ClassFontColor #2b2f36

class Modality {
  UUID id
  String code
  String name
  Category category
  IndexFactorApplication indexFactorApplication
  boolean hasContractualRate
  DayCountConvention contractualRateDayCountConvention
  DaysOverFixedBase marketRateDayCountConvention
  Integer inputDecimalPlaces
  RoundingRule intermediateRounding
  Integer intermediateDecimalPlaces
  RoundingRule outputRounding
  Integer outputDecimalPlaces
  boolean allowsInterestPayment
  boolean allowsAmortization
  boolean allowsInterestCapitalization
  Instant createdAt
  String createdBy
  Instant updatedAt
  String updatedBy
}

class Security {
  UUID id
  String code
  String name
  BigDecimal faceValueAtIssue
  LocalDate issueDate
  LocalDate compoundingStartDate
  LocalDate adjustmentStartDate
  LocalDate maturityDate
  BigDecimal contractualRate
  BigDecimal indexPercentage
  AmortizationBase amortizationBase
  int version
  Instant createdAt
  String createdBy
  Instant updatedAt
  String updatedBy
}

class Event {
  UUID id
  LocalDate eventDate
  EventType eventType
  BigDecimal amortizationFraction
  Instant createdAt
  String createdBy
  Instant updatedAt
  String updatedBy
}

class SecurityHistory {
  UUID id
  int version
  String snapshot
  Instant publishedAt
  Instant createdAt
  String createdBy
  Instant updatedAt
  String updatedBy
}

class Index {
  UUID id
  String code
  String name
  IndexValueType valueType
  Instant createdAt
  String createdBy
  Instant updatedAt
  String updatedBy
}

class IndexValue {
  UUID id
  LocalDate referenceDate
  BigDecimal value
  int version
  Instant createdAt
  String createdBy
  Instant updatedAt
  String updatedBy
}

class IndexValueHistory {
  UUID id
  int version
  String snapshot
  Instant publishedAt
  Instant createdAt
  String createdBy
  Instant updatedAt
  String updatedBy
}

Security "0..*" -l-> "1" Modality : follows
Security "0..*" -r-> "0..1" Index : indexed to
Security "1" *-- "0..*" Event : schedule
Security "1" *-- "1..*" SecurityHistory : versions
Index "1" *-- "0..*" IndexValue : values
IndexValue "1" *-l- "1..*" IndexValueHistory : versions

@enduml
